# ==============================================================================
# LFM3 Inference & Context Window Configuration
# ==============================================================================
# This configuration file is read automatically by:
#  - ./launchers/start_llama_server.sh
#  - ./launchers/start_llama_server.bat
#  - ./launchers/start_llama_server.ps1
#  - ./pi-lfm3
#
# LFM3 1.7B GGUF Model native trained context: 262,144 tokens (256k)
#
# Profile Presets:
# 1. Swarm Concurrency (Default):  CTX_SIZE=32768   PARALLEL_SLOTS=16  (~2k/slot)
# 2. Balanced Navigation:         CTX_SIZE=65536   PARALLEL_SLOTS=8   (~8k/slot)
# 3. Deep Code Reasoning:         CTX_SIZE=131072  PARALLEL_SLOTS=4   (~32k/slot)
# 4. Long Context Document/Repo:  CTX_SIZE=262144  PARALLEL_SLOTS=1   (~256k max)
# ==============================================================================

# Total unified KV cache memory pool in tokens
CTX_SIZE=32768

# Number of concurrent parallel execution slots
PARALLEL_SLOTS=16

# GPU Layers to offload (99 = full Apple Silicon Metal / NVIDIA CUDA offload)
N_GPU_LAYERS=99

# Server connection binding
HOST=127.0.0.1
PORT=8080

# Model specification
MODEL_ID=LiquidAI/LFM3-1.7B-GGUF:Q4_K_M
