# Read by launchers/start_llama_server.{sh,bat} and launchers/pi_lfm3.{sh,bat}. Written by setup_wizard.py.
#
# MODEL selects what start_llama_server runs:
#   dual   Spark-X2.6-4B on port 8080 and LFM3-1.7B on port 8081
#   spark  Spark-X2.6-4B on port 8080 (models/Spark-X2.6-4B-Q4_K_M.gguf if present, else Hugging Face)
#   lfm3   LFM3-1.7B on port 8081
#   other  a Hugging Face repo ID or .gguf path, served on PORT (default 8080)
#
# CTX_SIZE is the KV cache shared by all PARALLEL_SLOTS; each slot gets CTX_SIZE / PARALLEL_SLOTS tokens.
# Leave them empty for per-model defaults: Spark 65536 / 8, LFM3 32768 / 16. MODEL=dual always uses these defaults.
# Model maximums: Spark 1048576, LFM3 262144.
MODEL=dual
CTX_SIZE=
PARALLEL_SLOTS=
N_GPU_LAYERS=99
HOST=127.0.0.1
PORT=
