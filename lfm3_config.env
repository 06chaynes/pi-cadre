# ==============================================================================
# Multi-Model Inference & Context Window Configuration
# Supported Models:
#   1. Spark-X2.6-4B (XHToken): 4.0B Params, 1M Context (1,048,576 tokens)
#   2. LFM3-1.7B (LiquidAI):    1.7B Params, 256k Context (262,144 tokens)
# ==============================================================================
# This configuration file is read automatically by:
#  - ./launchers/start_llama_server.sh
#  - ./launchers/start_llama_server.bat
#  - ./launchers/start_llama_server.ps1
#  - ./pi-lfm3
# ==============================================================================

# Active Model Selector: "auto" (Dynamic Dual-Model Routing), "spark", or "lfm3"
ACTIVE_MODEL=auto

# ------------------------------------------------------------------------------
# Spark-X2.6-4B Profiles (Max Context: 1,048,576 tokens / 1M)
# ------------------------------------------------------------------------------
# 1. Swarm Concurrency:   CTX_SIZE=32768    PARALLEL_SLOTS=16  (~2k/slot)
# 2. Balanced (Default):  CTX_SIZE=65536    PARALLEL_SLOTS=8   (~8k/slot)
# 3. Deep Code Reasoning: CTX_SIZE=131072   PARALLEL_SLOTS=4   (~32k/slot)
# 4. Extended Subsystem:  CTX_SIZE=262144   PARALLEL_SLOTS=2   (~131k/slot)
# 5. Full 1M Monorepo:    CTX_SIZE=1048576  PARALLEL_SLOTS=1   (~1M tokens max)
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# LFM3-1.7B Profiles (Max Context: 262,144 tokens / 256k)
# ------------------------------------------------------------------------------
# 1. Swarm Concurrency:   CTX_SIZE=32768    PARALLEL_SLOTS=16  (~2k/slot)
# 2. Balanced Navigation: CTX_SIZE=65536    PARALLEL_SLOTS=8   (~8k/slot)
# 3. Deep Code Reasoning: CTX_SIZE=131072   PARALLEL_SLOTS=4   (~32k/slot)
# 4. Long Context Repo:   CTX_SIZE=262144   PARALLEL_SLOTS=1   (~256k tokens max)
# ------------------------------------------------------------------------------

# Active Runtime Parameters
CTX_SIZE=65536
PARALLEL_SLOTS=8
N_GPU_LAYERS=99

# Server connection binding
HOST=127.0.0.1
PORT=8080

# Model specification (local path or HuggingFace ID)
# When ACTIVE_MODEL=spark, prefers local models/Spark-X2.6-4B-Q4_K_M.gguf
MODEL_ID=models/Spark-X2.6-4B-Q4_K_M.gguf
