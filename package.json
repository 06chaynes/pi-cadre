{
  "name": "pi-cadre",
  "version": "0.3.1",
  "description": "Pi provider, per-task thinking, and model setup for small local models served by llama.cpp",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/06chaynes/pi-cadre.git"
  },
  "files": [
    "pi_extensions/*.ts",
    "!pi_extensions/*.test.ts"
  ],
  "pi": {
    "extensions": [
      "./pi_extensions/cadre.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "scripts": {
    "test": "node --test pi_extensions/*.test.ts",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
